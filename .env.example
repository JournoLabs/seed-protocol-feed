# Seed Protocol Feed - Environment Variables
# Copy this file to .env and customize for your deployment
# The .env file is gitignored and will not be committed to the repository

# REQUIRED: Your domain name for nginx configuration
NGINX_SITE=your-domain.com

# OPTIONAL: Server port for the Express server (default: 3000)
SERVER_PORT=3000

# Arweave gateway for article bodies and media URLs. @seedprotocol/feed 0.7.x
# defaults to ar.seedprotocol.io, which currently fails the TLS handshake; when
# that happens feeds still return 200 but without article bodies.
ARWEAVE_HOST=arweave.net

# OPTIONAL: Node heap (MB) for Vite client build on deploy (default: 4096)
# BUILD_NODE_HEAP_MB=4096

# OPTIONAL: Application name (default: seed-protocol-feed)
# APP_NAME=seed-protocol-feed

# OPTIONAL: Node environment (default: production)
# NODE_ENV=production
