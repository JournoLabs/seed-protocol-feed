{
  "name": "seed-protocol-feed",
  "version": "0.0.1",
  "description": "Generate RSS, Atom, and JSON feeds from Seed Protocol GraphQL queries with dynamic routing",
  "keywords": [
    "seed-protocol",
    "rss",
    "atom",
    "json",
    "feed"
  ],
  "author": "Seed Protocol <hello@seedprotocol.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JournoLabs/seed-protocol-feed.git"
  },
  "homepage": "https://github.com/JournoLabs/seed-protocol-feed#readme",
  "bugs": {
    "url": "https://github.com/JournoLabs/seed-protocol-feed/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seed-protocol-feed": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:client": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
    "dev:vite": "bun --env-file=.env run vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@seedprotocol/feed": "0.7.9",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "feedsmith": "^2.9.6",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "image-size": "^2.0.4",
    "pluralize": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.9",
    "@types/pluralize": "^0.0.33",
    "@types/supertest": "^7",
    "eslint": "^10.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "supertest": "^7.3.1",
    "typescript": "^7",
    "vite": "^8",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "bun@latest"
}
